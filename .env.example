# ── Database ──────────────────────────────────────────────────────────────────
SOCIAL_DATABASE_URL=postgresql://mizuhada:password@localhost:5433/mizuhada_social

# ── API server ────────────────────────────────────────────────────────────────
API_PORT=3001
DASHBOARD_ORIGIN=http://localhost:3000
DASHBOARD_PUBLIC_URL=http://localhost:3000

# ── Dashboard ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── AI / LLM ──────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_google_ai_studio_key

# Optional: override Gemini model used for relevance filtering
# GEMINI_RELEVANCE_MODEL=gemini-1.5-flash

# Optional: fallback LLM via OpenRouter (used when Gemini quota exceeded)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct
# OPENROUTER_VISION_MODEL=meta-llama/llama-3.2-11b-vision-instruct

# Optional: DeepSeek (used as XHS/CN translation fallback)
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# Optional: HuggingFace (embedding fallback)
# HUGGINGFACE_API_KEY=hf_xxx

# ── TikTok ────────────────────────────────────────────────────────────────────
# Persistent Chrome profile at ~/.tiktok-scraper-profile handles auth.
# Run: npm run tiktok:login — then scrapers reuse the saved session.
# Cookie header is optional fallback if profile session expires.
# TIKTOK_COOKIE_HEADER=sessionid=xxx; tt_csrf_token=yyy; ...
# TIKTOK_MS_TOKEN=your_msToken_value

# Optional proxy for TikTok requests
# TIKTOK_PROXY=http://proxy-host:port
# TIKTOK_PROXY_USER=username
# TIKTOK_PROXY_PASS=password

# Optional: limit feed scraper to one handle / search scraper to one brand slug
# TIKTOK_HANDLE=mizumi_official
# TIKTOK_SEARCH_BRAND=mizumi

# Optional: set to 1 to enable trending hashtag scrape
# TIKTOK_TRENDING_SCRAPE=0

# Optional: set to 1 for verbose TikTok scraper logs
# TIKTOK_DEBUG=0
# COMMENT_DEBUG=0
# COMMENT_DAYS=7

# ── Xiaohongshu (XHS) ─────────────────────────────────────────────────────────
# Required for XHS scrapers. Copy from browser DevTools → Application → Cookies → .xiaohongshu.com
# XHS_COOKIE_HEADER=web_session=xxx; a1=yyy; ...

# Optional: XHS captcha solver endpoint (if different from default)
# XHS_CAPTCHA_SOLVER=http://localhost:5001

# Optional: tuning
# XHS_MAX_SCROLLS=30
# XHS_SCROLL_MS=2000
# XHS_SCRAPE_COMMENTS=1
# XHS_STALE_LIMIT=10
# XHS_SEARCH_KEYWORD=mizumi

# Optional: set to 1 for verbose XHS logs
# XHS_DEBUG=0

# ── Instagram ─────────────────────────────────────────────────────────────────
# Persistent Chrome profile at ~/.ig-scraper-profile handles auth.
# Run: npm run ig:login — then scrapers reuse the saved session.

# Optional: tuning
# IG_COMMENT_DAYS=3
# IG_SEARCH_CHANNEL=branded

# Optional: set to 1 for verbose IG logs
# IG_DEBUG=0

# ── Douyin / Weibo (optional future platforms) ────────────────────────────────
# DOUYIN_COOKIES=your_douyin_cookie_header
# DOUYIN_DEBUG=0
# WEIBO_COOKIES=your_weibo_cookie_header
# WEIBO_DEBUG=0

# ── Alerts ────────────────────────────────────────────────────────────────────
# Teams: incoming webhook URL (spike alerts + weekly digest)
# MS_TEAMS_WEBHOOK_URL=https://your-tenant.webhook.office.com/...

# LINE: channel access token + group ID (alternative alert channel)
# LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_token
# LINE_GROUP_ID=your_line_group_id
# LINE_NOTIFY_TOKEN=your_line_notify_token
# LINE_FLEX_DEBUG=0

# ── Captcha solver ────────────────────────────────────────────────────────────
# ddddocr Flask microservice — start with: npm run captcha:solver
CAPTCHA_SOLVER_URL=http://localhost:5001

# ── Browser ───────────────────────────────────────────────────────────────────
# Optional: override Chrome executable path (auto-detected if not set)
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
