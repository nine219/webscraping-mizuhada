{
  "name": "mizuhada-intel",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "vitest run",
    "dev": "concurrently \"npm run api\" \"npm run dashboard:dev\"",
    "api": "ts-node -r dotenv/config src/api/server.ts dotenv_config_path=.env.local",
    "dashboard:dev": "cd dashboard && npm run dev",
    "scheduler": "ts-node -r dotenv/config src/scheduler/cron.ts dotenv_config_path=.env.local",
    "scraper:xhs:host": "ts-node -r dotenv/config src/scraper-runtime/scraper-entry.ts dotenv_config_path=.env.local",
    "tiktok:login": "ts-node -r dotenv/config src/tools/tiktok-login.ts dotenv_config_path=.env.local",
    "twitter:login": "ts-node -r dotenv/config src/tools/twitter-login.ts dotenv_config_path=.env.local",
    "xhs:login": "ts-node -r dotenv/config src/tools/xhs-login.ts dotenv_config_path=.env.local",
    "instagram:login": "ts-node -r dotenv/config src/tools/instagram-login.ts dotenv_config_path=.env.local",
    "dashboard:walkthrough": "ts-node -r dotenv/config src/tools/dashboard-walkthrough.ts dotenv_config_path=.env.local",
    "tiktok:auth": "ts-node -r dotenv/config src/tools/export-tiktok-cookies.ts dotenv_config_path=.env.local",
    "xhs:auth": "ts-node -r dotenv/config src/tools/export-xhs-cookies.ts dotenv_config_path=.env.local",
    "db:seed": "ts-node -r dotenv/config src/db/seed.ts dotenv_config_path=.env.local",
    "scrape:tiktok": "ts-node -r dotenv/config src/scrapers/tiktok/tiktok-feed.ts dotenv_config_path=.env.local",
    "scrape:tiktok:search": "ts-node -r dotenv/config src/scrapers/tiktok/tiktok-search.ts dotenv_config_path=.env.local",
    "scrape:tiktok-fc": "npm run scrape:tiktok && node -e \"setTimeout(()=>{},5000)\" && npm run scrape:tiktok:comments",
    "scrape:tiktok:comments": "ts-node -r dotenv/config src/scrapers/tiktok/tiktok-comments.ts dotenv_config_path=.env.local",
    "scrape:hashtags": "ts-node -r dotenv/config src/scrapers/tiktok/tiktok-trending-hashtags.ts dotenv_config_path=.env.local",
    "scrape:instagram": "ts-node -r dotenv/config src/scrapers/instagram/instagram-feed.ts dotenv_config_path=.env.local",
    "scrape:instagram:comments": "ts-node -r dotenv/config src/scrapers/instagram/instagram-comments.ts dotenv_config_path=.env.local",
    "db:migrate-social": "docker exec mizuhada-social-db psql -U mizuhada -d mizuhada_social -f /docker-entrypoint-initdb.d/01-schema.sql",
    "db:seed-social": "ts-node -r dotenv/config src/db/seed-social.ts dotenv_config_path=.env.local",
    "scrape:xhs:feed": "ts-node -r dotenv/config src/scrapers/xhs/xhs-feed.ts dotenv_config_path=.env.local",
    "scrape:xhs:search": "ts-node -r dotenv/config src/scrapers/xhs/xhs-search.ts dotenv_config_path=.env.local",
    "scrape:xhs:comments": "ts-node -r dotenv/config src/scrapers/xhs/xhs-comments.ts dotenv_config_path=.env.local",
    "analyze:sentiment": "ts-node -r dotenv/config src/tools/analyze-comments.ts dotenv_config_path=.env.local",
    "analyze:translate": "ts-node -r dotenv/config src/analysis/translate.ts dotenv_config_path=.env.local",
    "analyze:sentiment:xhs": "ts-node -r dotenv/config src/tools/sentiment-xhs.ts dotenv_config_path=.env.local",
    "digest:morning": "ts-node -r dotenv/config src/tools/send-digest.ts dotenv_config_path=.env.local",
    "captcha:solver": "python captcha-solver/solver.py",
    "big-scrape": "ts-node -r dotenv/config src/tools/big-scrape.ts dotenv_config_path=.env.local",
    "scrape:twitter:comments": "ts-node -r dotenv/config src/scrapers/twitter/twitter-comments.ts dotenv_config_path=.env.local",
    "report:campaign": "ts-node -r dotenv/config src/analysis/campaign-report.ts dotenv_config_path=.env.local"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "axios": "^1.7.7",
    "cheerio": "^1.0.0",
    "concurrently": "^9.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "franc": "^6.2.0",
    "node-cron": "^3.0.3",
    "pg": "^8.13.1",
    "playwright": "^1.49.0",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/franc": "*",
    "@types/node": "^22.9.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "keytar@7.9.0": true,
    "sqlite3@5.1.7": true,
    "tldjs@2.3.1": true
  }
}
